<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 色板 ==================== -->
    <!-- 主色 -->
    <Color x:Key="PrimaryColor">#0F6CBD</Color>
    <Color x:Key="PrimaryLightColor">#2886DE</Color>
    <Color x:Key="PrimaryTintColor">#E8F1FB</Color>

    <!-- 背景 -->
    <Color x:Key="BgPageColor">#F5F6F8</Color>
    <Color x:Key="BgCardColor">#FFFFFF</Color>
    <Color x:Key="BgSubtleColor">#FAFAFA</Color>

    <!-- 文字 -->
    <Color x:Key="TextPrimaryColor">#1B1A19</Color>
    <Color x:Key="TextSecondaryColor">#5A5A58</Color>
    <Color x:Key="TextTertiaryColor">#8A8886</Color>

    <!-- 功能色 -->
    <Color x:Key="SuccessColor">#0E700E</Color>
    <Color x:Key="WarningColor">#9D5D00</Color>
    <Color x:Key="DangerColor">#C50F1F</Color>

    <!-- 结构色 -->
    <Color x:Key="BorderColor">#E4E4E4</Color>
    <Color x:Key="BorderStrongColor">#C8C8C8</Color>
    <Color x:Key="HoverColor">#F0F0F0</Color>
    <Color x:Key="PressedColor">#E6E6E6</Color>
    <Color x:Key="DisabledColor">#C8C8C8</Color>

    <!-- 浅色调（标签底色） -->
    <Color x:Key="SuccessTintColor">#E7F3E7</Color>
    <Color x:Key="WarningTintColor">#FBF3E4</Color>
    <Color x:Key="DangerTintColor">#FCEAEC</Color>
    <Color x:Key="NeutralTintColor">#F0F0F0</Color>

    <!-- ==================== 画刷 ==================== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="PrimaryTintBrush" Color="{StaticResource PrimaryTintColor}" />

    <SolidColorBrush x:Key="BgPageBrush" Color="{StaticResource BgPageColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgSubtleBrush" Color="{StaticResource BgSubtleColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource SuccessTintColor}" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource WarningTintColor}" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="{StaticResource DangerTintColor}" />
    <SolidColorBrush x:Key="NeutralTintBrush" Color="{StaticResource NeutralTintColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}" />

    <!-- 卡片阴影：轻阴影 + 极低透明度，营造层级 -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="1" Opacity="0.07" Direction="270" Color="#000000" />
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="24" ShadowDepth="2" Opacity="0.13" Direction="270" Color="#001733" />
    <DropShadowEffect x:Key="NavShadow" BlurRadius="12" ShadowDepth="1" Opacity="0.05" Direction="0" Color="#000000" />

    <!-- ==================== 字体 ==================== -->
    <!-- 主体用 Noto Sans；中文字形回退到微软雅黑，保证中文观感不塌陷 -->
    <FontFamily x:Key="AppFont">Noto Sans, Microsoft YaHei UI, Segoe UI, Microsoft YaHei</FontFamily>

    <!-- 缓动，用于微交互动画 -->
    <Duration x:Key="FastDuration">0:0:0.15</Duration>
    <Duration x:Key="NormalDuration">0:0:0.2</Duration>
    <KeyTime x:Key="FastKeyTime">0:0:0.15</KeyTime>

    <!-- 尺寸 -->
    <CornerRadius x:Key="CornerSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerMedium">6</CornerRadius>
    <CornerRadius x:Key="CornerLarge">8</CornerRadius>
    <CornerRadius x:Key="CornerPill">999</CornerRadius>

</ResourceDictionary>
