<UserControl x:Class="FileKeeper.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FileKeeper.App.Converters"
             xmlns:services="clr-namespace:FileKeeper.App.Services"
             xmlns:log="clr-namespace:FileKeeper.Core.Logging;assembly=FileKeeper.Core"
             xmlns:models="clr-namespace:FileKeeper.Core.Models;assembly=FileKeeper.Core">

    <UserControl.RenderTransform>
        <TranslateTransform Y="0" />
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="10" To="0"
                                     Duration="0:0:0.2" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <UserControl.Resources>
        <conv:IntToVisibilityConverter x:Key="CountToVis" />
        <conv:UtcToLocalTextConverter x:Key="LocalTime" />
        <conv:EqualToVisibilityConverter x:Key="EqualToVisibility" />

        <!-- 运行记录行：任务名称 | 计划运行时间 | 启动时间 | 结束时间 | 运行总时长 | 状态 -->
        <DataTemplate x:Key="RunRecordTemplate" DataType="{x:Type services:TaskRunRecord}">
            <Border Padding="14,10" Margin="0,0,0,6" Background="{StaticResource BgCardBrush}"
                    CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding TaskName}"
                               Style="{StaticResource Body}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding TaskName}" />

                    <TextBlock Grid.Column="1" Text="{Binding ScheduledText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding StartedText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Grid.Column="3" Text="{Binding FinishedText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />

                    <Border Grid.Column="5" x:Name="StatusTag" Style="{StaticResource Tag}"
                            HorizontalAlignment="Left" Margin="12,0,0,0">
                        <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontSize="11" />
                    </Border>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                    <Setter TargetName="StatusTag" Property="Background" Value="{StaticResource DangerTintBrush}" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="StatusTag" Property="Background" Value="{StaticResource WarningTintBrush}" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding StatusText}" Value="成功">
                    <Setter TargetName="StatusTag" Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type log:LogEntry}">
            <Border Padding="14,10" Margin="0,0,0,6" Background="{StaticResource BgCardBrush}"
                    CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Timestamp, Converter={StaticResource LocalTime}, ConverterParameter=Time}"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />

                    <Border x:Name="LevelTag" Grid.Column="1" Style="{StaticResource Tag}"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="LevelText" Text="信息" FontSize="11" />
                    </Border>

                    <TextBlock Grid.Column="2"
                               Text="{Binding Context}"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,12,0" />

                    <TextBlock Grid.Column="3"
                               Text="{Binding Message}"
                               Style="{StaticResource Body}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Error}">
                    <Setter TargetName="LevelTag" Property="Background"
                            Value="{StaticResource DangerTintBrush}" />
                    <Setter TargetName="LevelText" Property="Foreground"
                            Value="{StaticResource DangerBrush}" />
                    <Setter TargetName="LevelText" Property="Text" Value="错误" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Warn}">
                    <Setter TargetName="LevelTag" Property="Background"
                            Value="{StaticResource WarningTintBrush}" />
                    <Setter TargetName="LevelText" Property="Foreground"
                            Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="LevelText" Property="Text" Value="警告" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Info}">
                    <Setter TargetName="LevelTag" Property="Background"
                            Value="{StaticResource PrimaryTintBrush}" />
                    <Setter TargetName="LevelText" Property="Foreground"
                            Value="{StaticResource PrimaryBrush}" />
                    <Setter TargetName="LevelText" Property="Text" Value="信息" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <!-- 标题行 -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="运行日志" Style="{StaticResource H1}" />
                    <TextBlock Text="日志由后台服务写入。服务未安装时，手动执行也会记录到这里。"
                               Style="{StaticResource Caption}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="打开日志文件夹"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenFolderCommand}" />
                    <Button Content="清理过期日志"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0"
                            Command="{Binding PurgeCommand}" />
                    <Button Content="&#xE72C;"
                            ToolTip="刷新"
                            Style="{StaticResource IconButton}"
                            Margin="8,0,0,0"
                            Command="{Binding LoadCommand}" />
                </StackPanel>
            </Grid>

            <!-- 筛选条 -->
            <Grid Margin="0,16,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox ItemsSource="{Binding AvailableDates}"
                          SelectedItem="{Binding SelectedDate}" />

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ViewModes}"
                          SelectedItem="{Binding ViewMode}"
                          Margin="10,0,0,0" />

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding LevelFilters}"
                          SelectedItem="{Binding LevelFilter}"
                          Margin="10,0,0,0" />

                <TextBox Grid.Column="3"
                         Margin="10,0,0,0"
                         Tag="按关键字或任务名筛选"
                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Grid.Column="4"
                          Content="自动刷新"
                          IsChecked="{Binding AutoRefresh}"
                          Margin="16,0,0,0"
                          VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <!-- 列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0" Padding="0,0,10,0">
            <StackPanel>
                <!-- 运行记录视图 -->
                <StackPanel Visibility="{Binding ViewMode, Converter={StaticResource EqualToVisibility}, ConverterParameter=运行记录}">
                    <Grid Margin="14,0,14,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="任务名称" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="计划运行时间" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="12,0,0,0" />
                        <TextBlock Grid.Column="2" Text="启动时间" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="12,0,0,0" />
                        <TextBlock Grid.Column="3" Text="结束时间" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="12,0,0,0" />
                        <TextBlock Grid.Column="4" Text="运行总时长" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="12,0,0,0" />
                        <TextBlock Grid.Column="5" Text="状态" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="12,0,0,0" />
                    </Grid>

                    <Border Style="{StaticResource Section}"
                            Padding="18"
                            Visibility="{Binding Runs.Count, Converter={StaticResource CountToVis}}">
                        <TextBlock Text="当前日期没有任务运行记录。"
                                   Style="{StaticResource Caption}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Runs}" ItemTemplate="{StaticResource RunRecordTemplate}" />
                </StackPanel>

                <!-- 原始日志视图 -->
                <StackPanel Visibility="{Binding ViewMode, Converter={StaticResource EqualToVisibility}, ConverterParameter=原始日志}">
                    <Border Style="{StaticResource Section}"
                            Padding="18"
                            Visibility="{Binding Entries.Count, Converter={StaticResource CountToVis}}">
                        <TextBlock Text="当前筛选条件下没有日志记录。"
                                   Style="{StaticResource Caption}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource LogEntryTemplate}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 统计 -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,12,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding StatisticsText}" Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding LogsDirectory}"
                           Style="{StaticResource Hint}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
