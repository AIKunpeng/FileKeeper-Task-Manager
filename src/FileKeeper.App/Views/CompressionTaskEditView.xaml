<UserControl x:Class="FileKeeper.App.Views.CompressionTaskEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FileKeeper.App.Views"
             xmlns:conv="clr-namespace:FileKeeper.App.Converters"
             xmlns:h="clr-namespace:FileKeeper.App.Services"
             xmlns:core="clr-namespace:FileKeeper.Core.Models;assembly=FileKeeper.Core">

    <UserControl.RenderTransform>
        <TranslateTransform Y="0" />
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="10" To="0"
                                     Duration="0:0:0.2" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="FormatToBool" EnumType="{x:Type core:ArchiveFormat}" />
        <conv:EnumToBooleanConverter x:Key="FilterToBool" EnumType="{x:Type core:FileFilterMode}" />
        <conv:EnumToVisibilityConverter x:Key="FilterToVis" EnumType="{x:Type core:FileFilterMode}" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringListConverter x:Key="StringList" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Grid Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BackButton}" Command="{Binding CancelCommand}" />
                <TextBlock Text="{Binding EditorTitle}"
                           Style="{StaticResource H1}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </StackPanel>

            <CheckBox Content="启用此任务"
                      Style="{StaticResource ToggleSwitch}"
                      IsChecked="{Binding Enabled}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
        </Grid>

        <!-- 表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                <!-- 基础 -->
                <Border Style="{StaticResource Section}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="基础" Style="{StaticResource H2}" Margin="0,0,0,14" />

                        <TextBlock Text="任务名称" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="例如：每天压缩日志" />

                        <TextBlock Text="源目录" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="选择要压缩的目录" />
                            <Button Grid.Column="1"
                                    Content="浏览..."
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseSourceCommand}" />
                        </Grid>

                        <CheckBox Content="包含子目录"
                                  IsChecked="{Binding IncludeSubDirectories}"
                                  Margin="0,14,0,0" />

                        <TextBlock Text="文件过滤" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                        <Border Background="{StaticResource BgSubtleBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="3"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="全部文件"
                                             Style="{StaticResource SegmentedItem}"
                                             Height="30"
                                             IsChecked="{Binding FilterMode, Converter={StaticResource FilterToBool}, ConverterParameter=All}" />
                                <RadioButton Content="仅指定扩展名"
                                             Style="{StaticResource SegmentedItem}"
                                             Height="30"
                                             IsChecked="{Binding FilterMode, Converter={StaticResource FilterToBool}, ConverterParameter=IncludeExtensions}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding FilterMode, Converter={StaticResource FilterToVis}, ConverterParameter=IncludeExtensions}">
                            <TextBlock Text="扩展名，多个用逗号分隔" Style="{StaticResource FieldLabel}" />
                            <TextBox Tag=".log, .txt"
                                     Text="{Binding Extensions, Converter={StaticResource StringList}, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="排除的子目录，多个用逗号分隔"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,12,0,0" />
                            <TextBox Tag="node_modules, logs"
                                     Text="{Binding ExcludedDirectories, Converter={StaticResource StringList}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 输出 -->
                <Border Style="{StaticResource Section}" Padding="20" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="输出" Style="{StaticResource H2}" Margin="0,0,0,14" />

                        <TextBlock Text="压缩包存放目录" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="选择压缩包的存放位置" />
                            <Button Grid.Column="1"
                                    Content="浏览..."
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseOutputCommand}" />
                        </Grid>

                        <TextBlock Text="文件名模板" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                        <TextBox Text="{Binding FileNameTemplate, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Backup_{yyyyMMdd}_{HHmmss}" />
                        <Border Style="{StaticResource InfoBar}" Margin="0,8,0,0">
                            <TextBlock Text="{Binding PreviewFileName}" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource PrimaryBrush}" />
                        </Border>

                        <TextBlock Text="压缩格式" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="ZIP"
                                         Style="{StaticResource SegmentedItem}"
                                         Height="32"
                                         MinWidth="90"
                                         IsChecked="{Binding Format, Converter={StaticResource FormatToBool}, ConverterParameter=Zip}" />
                            <RadioButton Content="RAR"
                                         Style="{StaticResource SegmentedItem}"
                                         Height="32"
                                         MinWidth="90"
                                         IsEnabled="{Binding CanCreateRar}"
                                         ToolTip="{Binding RarHint}"
                                         IsChecked="{Binding Format, Converter={StaticResource FormatToBool}, ConverterParameter=Rar}" />
                        </StackPanel>

                        <Border Style="{StaticResource WarningBar}"
                                Margin="0,10,0,0"
                                Visibility="{Binding CanCreateRar, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <TextBlock Text="{Binding RarHint}" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource WarningBrush}" />
                        </Border>

                        <TextBlock Text="压缩级别" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding CompressionLevels}"
                                      SelectedItem="{Binding CompressionLevel}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CompressionLevelText}"
                                       Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 高级 -->
                <Border Style="{StaticResource Section}" Padding="20" Margin="0,14,0,0">
                    <StackPanel>
                        <Expander>
                            <Expander.Header>
                                <TextBlock Text="高级选项" Style="{StaticResource H2}" />
                            </Expander.Header>

                            <StackPanel Margin="0,4,0,0">
                                <CheckBox Content="为压缩包设置密码"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding UsePassword}" />

                                <PasswordBox Margin="0,10,0,0"
                                             Height="34"
                                             IsEnabled="{Binding UsePassword}"
                                             h:PasswordBoxHelper.Attach="True"
                                             h:PasswordBoxHelper.Password="{Binding Password, Mode=TwoWay}" />

                                <CheckBox Content="启用分卷"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding UseVolume}"
                                          Margin="0,16,0,0" />

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0"
                                            IsEnabled="{Binding UseVolume}">
                                    <TextBlock Text="每卷大小"
                                               Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" />
                                    <TextBox Width="96"
                                             Margin="10,0,0,0"
                                             Text="{Binding VolumeSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="MB"
                                               Style="{StaticResource Caption}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </StackPanel>

                                <Border Style="{StaticResource DangerBar}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <CheckBox Content="压缩成功后删除源文件"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding DeleteSourceAfterCompress}" />
                                        <TextBlock Text="源文件将被永久删除，不可恢复。请确认压缩包已成功生成后再启用。"
                                                   Style="{StaticResource Caption}"
                                                   Foreground="#8A0C16"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- 调度 -->
                <Border Style="{StaticResource Section}" Padding="20" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="调度" Style="{StaticResource H2}" Margin="0,0,0,14" />
                        <views:ScheduleEditorControl DataContext="{Binding Schedule}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作条 -->
        <Border Grid.Row="2"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" />
                <Button Content="立即执行"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Command="{Binding RunCommand}" />
                <Button Content="保存"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
