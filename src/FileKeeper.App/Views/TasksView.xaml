<UserControl x:Class="FileKeeper.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FileKeeper.App.ViewModels"
             xmlns:conv="clr-namespace:FileKeeper.App.Converters">

    <UserControl.RenderTransform>
        <TranslateTransform Y="0" />
    </UserControl.RenderTransform>

    <!-- 页面入场：200ms 淡入并轻微上移 -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="10" To="0"
                                     Duration="0:0:0.2" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:IntToVisibilityConverter x:Key="CountToVis" />

        <!-- 任务卡片。悬停上浮 2px，与顶部 200ms 位移入场一致 -->
        <DataTemplate x:Key="TaskCardTemplate" DataType="{x:Type vm:TaskItemViewModel}">
            <Border x:Name="Card"
                    Width="330"
                    Background="{StaticResource BgCardBrush}"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,14,14"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="1" Opacity="0.07" Direction="270" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="CardTranslate" Y="0" />
                </Border.RenderTransform>

                <StackPanel>
                    <!-- 标题行 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Name}"
                                   Style="{StaticResource H2}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- 执行中：橙色，排在已启用前面，两个标记可同时出现 -->
                            <Border x:Name="RunTag"
                                    Style="{StaticResource Tag}"
                                    Background="{StaticResource WarningTintBrush}"
                                    Margin="0,0,4,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="RunText" Text="执行中" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                            </Border>

                            <Border x:Name="StateTag" Style="{StaticResource Tag}">
                                <TextBlock x:Name="StateText" Text="已禁用" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 位置 -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{Binding LocationLabel}" Style="{StaticResource Caption}" />
                        <TextBlock Text="：" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding LocationText}"
                                   Style="{StaticResource Caption}"
                                   MaxWidth="230"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 调度 -->
                    <TextBlock Text="{Binding ScheduleText}" Style="{StaticResource Body}" Margin="0,6,0,0" />

                    <!-- 上次 / 下次 -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="上次 " Style="{StaticResource Hint}" />
                        <TextBlock Text="{Binding LastRunText}" Style="{StaticResource Hint}" />
                        <TextBlock Text="   ·   下次 " Style="{StaticResource Hint}" />
                        <TextBlock Text="{Binding NextRunText}" Style="{StaticResource Hint}" />
                    </StackPanel>

                    <!-- 操作 -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="ToggleButton"
                                Content="启用"
                                Style="{StaticResource LinkButton}"
                                MinWidth="52"
                                Command="{Binding DataContext.ToggleEnabledCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />

                        <Button x:Name="RunButton"
                                Content="&#xE768;"
                                ToolTip="立即执行"
                                Style="{StaticResource SmallIconButton}"
                                Command="{Binding DataContext.RunCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />

                        <Button Content="&#xE70F;"
                                ToolTip="编辑"
                                Style="{StaticResource SmallIconButton}"
                                Command="{Binding DataContext.EditCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />

                        <Button Content="&#xE74D;"
                                ToolTip="删除"
                                Style="{StaticResource SmallIconButton}"
                                Command="{Binding DataContext.DeleteCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="True">
                    <Setter TargetName="StateTag" Property="Background"
                            Value="{StaticResource SuccessTintBrush}" />
                    <Setter TargetName="StateText" Property="Text" Value="已启用" />
                    <Setter TargetName="StateText" Property="Foreground"
                            Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="ToggleButton" Property="Content" Value="禁用" />
                </DataTrigger>

                <!-- 执行中：显示橙色标记，播放按钮换成终止按钮 -->
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="RunTag" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RunButton" Property="Content" Value="&#xE71A;" />
                    <Setter TargetName="RunButton" Property="ToolTip" Value="终止执行" />
                    <Setter TargetName="RunButton" Property="Foreground" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="RunButton"
                            Property="Command"
                            Value="{Binding DataContext.StopCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                </DataTrigger>

                <EventTrigger RoutedEvent="MouseEnter" SourceName="Card">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                             Storyboard.TargetProperty="Y"
                                             To="-2"
                                             Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseLeave" SourceName="Card">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                             Storyboard.TargetProperty="Y"
                                             To="0"
                                             Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Grid Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="任务总览" Style="{StaticResource H1}" />
                    <!-- 左侧导航选中单个分区时，这里用一枚色块说明当前只显示了哪一类 -->
                    <Border Background="{StaticResource PrimaryTintBrush}"
                            CornerRadius="10"
                            Padding="9,2,4,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FilterText}"
                                       FontSize="11"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button Content="显示全部"
                                    Style="{StaticResource LinkButton}"
                                    Height="20"
                                    FontSize="11"
                                    Margin="4,0,0,0"
                                    Command="{Binding ClearFilterCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="按调度自动压缩、清理、上传文件并执行脚本程序。服务未安装时，定时任务不会自动执行。"
                           Style="{StaticResource Caption}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{Binding RunAllButtonText}"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="96"
                        Command="{Binding RunVisibleCommand}" />
            </StackPanel>
        </Grid>

        <!-- 四个分区：新建入口在各分区标题右侧，显示与否由左侧导航的选中项决定 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                <!-- 压缩 -->
                <StackPanel Margin="0,0,0,22"
                            Visibility="{Binding ShowCompressionSection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2"
                                   Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="压缩任务" Style="{StaticResource H2}" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding CompressionTasks.Count, StringFormat=（{0}）}"
                                   Style="{StaticResource Caption}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                        <Button Content="+ 新建压缩任务"
                                Style="{StaticResource LinkButton}"
                                Height="26"
                                FontSize="12"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding NewCompressionCommand}" />
                    </StackPanel>

                    <Border Style="{StaticResource Section}"
                            Padding="18"
                            Visibility="{Binding CompressionTasks.Count, Converter={StaticResource CountToVis}}">
                        <TextBlock Text="还没有压缩任务。点击标题旁的「+ 新建压缩任务」，把指定目录按调度打包成 ZIP 或 RAR。"
                                   Style="{StaticResource Caption}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding CompressionTasks}"
                                  ItemTemplate="{StaticResource TaskCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- 清理 -->
                <StackPanel Margin="0,0,0,22"
                            Visibility="{Binding ShowCleanupSection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2"
                                   Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="清理任务" Style="{StaticResource H2}" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding CleanupTasks.Count, StringFormat=（{0}）}"
                                   Style="{StaticResource Caption}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                        <Button Content="+ 新建清理任务"
                                Style="{StaticResource LinkButton}"
                                Height="26"
                                FontSize="12"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding NewCleanupCommand}" />
                    </StackPanel>

                    <Border Style="{StaticResource Section}"
                            Padding="18"
                            Visibility="{Binding CleanupTasks.Count, Converter={StaticResource CountToVis}}">
                        <TextBlock Text="还没有清理任务。清理会永久删除超过设定时间的文件，操作不可恢复。"
                                   Style="{StaticResource Caption}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding CleanupTasks}"
                                  ItemTemplate="{StaticResource TaskCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- 同步 -->
                <StackPanel Margin="0,0,0,22"
                            Visibility="{Binding ShowSyncSection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2"
                                   Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="同步任务" Style="{StaticResource H2}" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding SyncTasks.Count, StringFormat=（{0}）}"
                                   Style="{StaticResource Caption}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                        <Button Content="+ 新建同步任务"
                                Style="{StaticResource LinkButton}"
                                Height="26"
                                FontSize="12"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding NewSyncCommand}" />
                    </StackPanel>

                    <Border Style="{StaticResource Section}"
                            Padding="18"
                            Visibility="{Binding SyncTasks.Count, Converter={StaticResource CountToVis}}">
                        <TextBlock Text="还没有同步任务。同步会把本地目录的文件上传到 SFTP 或 FTP 服务器，仅单向上传。"
                                   Style="{StaticResource Caption}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding SyncTasks}"
                                  ItemTemplate="{StaticResource TaskCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- 程序 -->
                <StackPanel Visibility="{Binding ShowProgramSection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2"
                                   Fill="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="程序任务" Style="{StaticResource H2}" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding ProgramTasks.Count, StringFormat=（{0}）}"
                                   Style="{StaticResource Caption}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                        <Button Content="+ 新建程序任务"
                                Style="{StaticResource LinkButton}"
                                Height="26"
                                FontSize="12"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding NewProgramCommand}" />
                    </StackPanel>

                    <Border Style="{StaticResource Section}"
                            Padding="18"
                            Visibility="{Binding ProgramTasks.Count, Converter={StaticResource CountToVis}}">
                        <TextBlock Text="还没有程序任务。程序任务按调度执行脚本或程序（exe、bat、ps1），输出写入日志，超时自动结束。"
                                   Style="{StaticResource Caption}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding ProgramTasks}"
                                  ItemTemplate="{StaticResource TaskCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部：进度或汇总 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding SummaryText}"
                       Style="{StaticResource Caption}"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

            <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <TextBlock Text="{Binding BusyText}"
                               Style="{StaticResource Caption}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                    <Button Content="取消"
                            Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Right"
                            Command="{Binding RunAllCancelCommand}" />
                </Grid>
                <ProgressBar Value="{Binding ProgressValue}"
                             Maximum="100"
                             Margin="0,6,0,0"
                             IsIndeterminate="False" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
