<UserControl x:Class="FileKeeper.App.Views.ProgramTaskEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FileKeeper.App.Views"
             xmlns:conv="clr-namespace:FileKeeper.App.Converters"
             xmlns:core="clr-namespace:FileKeeper.Core.Models;assembly=FileKeeper.Core">

    <UserControl.RenderTransform>
        <TranslateTransform Y="0" />
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="10" To="0"
                                     Duration="0:0:0.2" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="WindowToBool" EnumType="{x:Type core:ProcessWindow}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BackButton}" Command="{Binding CancelCommand}" />
                <TextBlock Text="{Binding EditorTitle}"
                           Style="{StaticResource H1}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </StackPanel>

            <CheckBox Content="启用此任务"
                      Style="{StaticResource ToggleSwitch}"
                      IsChecked="{Binding Enabled}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                <!-- 目标 -->
                <Border Style="{StaticResource Section}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="目标" Style="{StaticResource H2}" Margin="0,0,0,14" />

                        <TextBlock Text="任务名称" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="例如：每夜备份脚本" />

                        <TextBlock Text="程序或脚本" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="选择 .exe、.bat、.cmd 或 .ps1 文件" />
                            <Button Grid.Column="1"
                                    Content="浏览..."
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseFileCommand}" />
                        </Grid>

                        <TextBlock Text="命令行参数（可选）" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="例如：--verbose D:\data" />

                        <TextBlock Text="工作目录（可选，留空用程序所在目录）"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,16,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Content="浏览..."
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseWorkingDirectoryCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 运行方式 -->
                <Border Style="{StaticResource Section}" Padding="20" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="运行方式" Style="{StaticResource H2}" Margin="0,0,0,14" />

                        <TextBlock Text="窗口形态" Style="{StaticResource FieldLabel}" />
                        <Border Background="{StaticResource BgSubtleBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="3"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="隐藏窗口"
                                             Style="{StaticResource SegmentedItem}"
                                             Height="30"
                                             IsChecked="{Binding WindowMode, Converter={StaticResource WindowToBool}, ConverterParameter=Hidden}" />
                                <RadioButton Content="最小化"
                                             Style="{StaticResource SegmentedItem}"
                                             Height="30"
                                             IsChecked="{Binding WindowMode, Converter={StaticResource WindowToBool}, ConverterParameter=Minimized}" />
                                <RadioButton Content="正常显示"
                                             Style="{StaticResource SegmentedItem}"
                                             Height="30"
                                             IsChecked="{Binding WindowMode, Converter={StaticResource WindowToBool}, ConverterParameter=Normal}" />
                            </StackPanel>
                        </Border>

                        <CheckBox Content="启动后立即完成，不等待退出"
                                  IsChecked="{Binding WaitForExit}"
                                  Margin="0,16,0,0" />
                        <TextBlock Text="勾选后程序启动成功即算执行完成，适合 Typora、微信这类打开后长期驻留的图形界面程序；不勾选则等待退出并用退出码判定成败，适合脚本与命令行工具。"
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <TextBlock Text="超时（秒），到时未退出的程序会被强制结束并判定失败（仅在等待退出时生效）"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,16,0,0" />
                        <TextBox Width="160"
                                 HorizontalAlignment="Left"
                                 Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />

                        <Border Style="{StaticResource InfoBar}" Margin="0,14,0,0">
                            <TextBlock Text="后台服务以系统身份运行定时任务，脚本的窗口不会出现在桌面上；标准输出与错误会写入日志，退出码非 0 视为失败。图形界面程序建议选择「正常显示」并勾选「启动后立即完成」。"
                                       Style="{StaticResource Caption}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 调度 -->
                <Border Style="{StaticResource Section}" Padding="20" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="调度" Style="{StaticResource H2}" Margin="0,0,0,14" />
                        <views:ScheduleEditorControl DataContext="{Binding Schedule}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" />
                <Button Content="立即执行"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Command="{Binding RunCommand}" />
                <Button Content="保存"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
