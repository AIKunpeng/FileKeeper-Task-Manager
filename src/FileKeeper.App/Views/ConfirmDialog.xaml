<Window x:Class="FileKeeper.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True">
    <!-- 外框留 16px 边距，给阴影留出渲染空间 -->
    <Border Margin="16"
            Background="{StaticResource BgCardBrush}"
            CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="3" Opacity="0.22" Direction="270" Color="#001733" />
        </Border.Effect>

        <Grid x:Name="Root" Margin="24,22" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="0" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText"
                           Style="{StaticResource Body}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           LineHeight="20" />
            </StackPanel>

            <Border x:Name="DetailBar"
                    Grid.Row="1"
                    Style="{StaticResource DangerBar}"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="DetailText"
                           Style="{StaticResource Caption}"
                           Foreground="#8A0C16"
                           TextWrapping="Wrap" />
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="CancelButton"
                        Content="取消"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True"
                        Click="OnCancelClick" />
                <Button x:Name="ConfirmButton"
                        Content="确定"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Margin="10,0,0,0"
                        Click="OnConfirmClick" />
            </StackPanel>
        </Grid>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Root"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1"
                                         Duration="0:0:0.15" />
                        <DoubleAnimation Storyboard.TargetName="Root"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         From="12" To="0"
                                         Duration="0:0:0.2" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</Window>
